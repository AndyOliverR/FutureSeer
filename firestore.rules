rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function userProfileAllowedKeys() {
      return [
        'uid',
        'email',
        'displayName',
        'fullName',
        'photoURL',
        'isSubscribed',
        'isTipped',
        'createdAt',
        'lastLoginAt',
        'birthDate',
        'birthPlace',
        'birthTime',
        'birthTimeKnown',
        'birthTimePeriod',
        'birthTimeNote',
        'birthLatitude',
        'birthLongitude',
        'latitude',
        'longitude',
        'coordinatesResolvedAt',
        'currentLocation',
        'gender',
        'facePhotoUrl',
        'palmPhotoUrl',
        'emailVerified',
        'providerData',
        'lastSignInTime',
        'creationTime',
        'updatedAt',
        'mysticalProfileGenerated',
        'profileDataHash',
        'profileStatus',
        'country',
        'paymentMethodId',
        'subscriptionId',
        'selectedPlan',
        'autoMandateAccepted',
        'freeTrialTermsAccepted',
        'freeTrialTermsAcceptedAt',
        'subscriptionStatus',
        'noChargeAccount',
        'trialEndDate',
        'trialEndTime',
        'nextBillingDate',
        'referralCode',
        'referralCount',
        'freeMonthsRemaining',
        'notificationsEnabled',
        'emailUpdates',
        'relationshipStatus',
        'hasChildren',
        'numberOfChildren',
        'divinationInterests',
        'notificationPreferences',
        'seerIncludeNewsHeadlines',
        'timezone',
        'specialUser',
        'special_user',
        'isSpecialUser',
        'profileEditCount',
        'profileEditPeriodStart'
      ];
    }

    function protectedUserKeys() {
      return [
        'isSubscribed',
        'selectedPlan',
        'paymentMethodId',
        'subscriptionId',
        'subscriptionStatus',
        'noChargeAccount',
        'trialEndDate',
        'trialEndTime',
        'nextBillingDate',
        'specialUser',
        'special_user',
        'isSpecialUser',
        'profileEditCount',
        'profileEditPeriodStart',
        'freeMonthsRemaining'
      ];
    }

    function validUserCreate(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(userProfileAllowedKeys())
        && (!('selectedPlan' in request.resource.data) || request.resource.data.selectedPlan in ['power-user-trial', 'trial', ''])
        && (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'trial')
        && (!('isSubscribed' in request.resource.data) || request.resource.data.isSubscribed == false)
        && (!('noChargeAccount' in request.resource.data) || request.resource.data.noChargeAccount == false)
        && (!('specialUser' in request.resource.data) || request.resource.data.specialUser == false)
        && (!('special_user' in request.resource.data) || request.resource.data.special_user == false)
        && (!('isSpecialUser' in request.resource.data) || request.resource.data.isSpecialUser == false);
    }

    function validUserUpdate(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(userProfileAllowedKeys())
        && request.resource.data.diff(resource.data).changedKeys().hasAny(protectedUserKeys()) == false;
    }

    // Allow users to read and write their own data
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate(userId);
      allow update: if isOwner(userId) && validUserUpdate(userId);
      allow delete: if false;
      
      // Allow access to user subcollections (astroProfile, numerologyProfile, etc.)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }
    
    // Allow users to read and write their own notes
    match /notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read and write their own ask history
    match /askHistory/{historyId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read and write their own activity log
    match /userActivity/{activityId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    
    // Allow users to read and write their own daily guidance
    match /dailyGuidance/{guidanceId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
    
    // Vedic analyses: scope by userId on the document (Admin SDK bypasses rules for server writes)
    match /vedicAnalyses/{analysisId} {
      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
    }
    
    // Allow users to read and write their own comprehensive mystical profiles
    match /comprehensiveMysticalProfiles/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Seer Master (normalized insight for Ask the Seer) - user can read own
    match /seerMaster/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Only server writes via Admin SDK
    }
    
    // Seer decision telemetry - server writes only; admin read for dashboards
    match /seerDecisionEvents/{eventId} {
      allow read, write: if false; // Only Admin SDK
    }
    
    // Community discussions - anyone authenticated can read, only author can edit/delete
    match /communityDiscussions/{discussionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }
    
    // Community votes - prevent duplicate votes
    match /communityVotes/{voteId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Community members - anyone can read, only own profile can be updated
    match /communityMembers/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Community connections - read own requests, create to others
    match /communityConnections/{connectionId} {
      allow read: if request.auth != null && (resource.data.fromUserId == request.auth.uid || resource.data.toUserId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.fromUserId == request.auth.uid;
      allow update: if request.auth != null && resource.data.toUserId == request.auth.uid;
    }
    
    // Community contributions - read own, create own, update own
    match /communityContributions/{contributionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Community stats - read only for all authenticated users
    match /communityStats/{statsId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server/admin can write
    }
    
    // Tool interest — API uses Admin SDK (bypasses rules). Block anonymous client Firestore spam.
    match /toolInterests/{interestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && (request.auth.token.admin == true || request.auth.token.superadmin == true);
    }
  }
}