    "@capacitor/android": "^7.6.1",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/core": "^7.6.1",
    "@capacitor/ios": "^7.6.1",
    "@hebcal/core": "^6.0.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "latest",
