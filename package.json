    "cmdk": "latest",
    "date-fns": "4.1.0",
    "dotenv": "^17.2.2",
    "embla-carousel-react": "latest",
    "firebase": "latest",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.23.0",
    "groq-sdk": "^0.34.0",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "i18next": "^25.3.2",
    "input-otp": "latest",
    "iztro": "^2.5.3",
    "konsta": "^5.0.7",
    "lucide-react": "^0.454.0",
    "luxon": "^3.6.1",
    "next": "16.2.3",
    "next-i18next": "^15.4.2",
    "next-themes": "latest",
