    "recharts": "latest",
    "resend": "^6.12.2",
    "rrweb-snapshot": "latest",
    "sonner": "latest",
    "swisseph": "^0.5.17",
    "swisseph-wasm": "^0.0.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "latest",
    "ws": "latest",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^39.8.1",
    "eslint": "^9.33.0",
    "eslint-config-next": "16.2.3",
