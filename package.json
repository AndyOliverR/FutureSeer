    "@radix-ui/react-toggle-group": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@react-pdf/renderer": "^4.3.0",
    "@rrweb/types": "latest",
    "ai": "^5.0.52",
    "astronomia": "^4.2.0",
    "autoprefixer": "^10.4.20",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
