{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:nocache": "cross-env DISABLE_WEBPACK_CACHE=1 next dev --webpack",
    "generate:starfield": "node scripts/generate-starfield-8k.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "npx eslint .",
    "lint:security": "pnpm exec eslint app/api scripts lib --ext .js,.ts --max-warnings 100000 --rule \"@typescript-eslint/no-explicit-any:off\" --rule \"@typescript-eslint/no-unused-vars:off\"",
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix",
    "security:audit": "pnpm audit --audit-level=high",
    "security": "node scripts/run-security.mjs",
    "check:firebase-admin": "node scripts/check-firebase-admin-env.mjs",
    "setup-users": "node scripts/setup-user-modes.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest tests/integration --testTimeout=15000",
    "test:seer": "npx ts-node tests/regressionRunner.ts",
    "test:core-stability": "npx ts-node tests/runCoreStabilityCheck.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "pnpm run build && start-server-and-test \"pnpm start\" http://localhost:3000 \"pnpm exec playwright test\"",
    "electron": "electron .",
    "desktop": "next build && concurrently -k \"next start\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:linux": "next build && cross-env ELECTRON_NO_SANDBOX=1 concurrently -k \"next start\" \"wait-on http://localhost:3000 && electron .\"",
    "build:capacitor": "cross-env CAPACITOR_BUILD=1 next build --webpack",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "node scripts/run-cap-sync-clean-env.mjs",
    "mobile:build": "pnpm run build:capacitor && node scripts/run-cap-sync-clean-env.mjs",
    "audit:sitemap:live": "node scripts/audit-sitemap-live.mjs",
    "audit:gsc-hygiene": "node scripts/gsc-manual-checklist.mjs",
    "audit:google-presence": "node scripts/google-presence-checklist.mjs",
    "linux:readiness": "node scripts/linux-readiness-check.mjs",
    "ui:audit:tokens": "powershell -NoProfile -Command \"Get-ChildItem app,components -Recurse -Include *.tsx | Select-String -Pattern 'bg-slate-|text-slate-|bg-white/|border-amber-|h-\\[800px\\]|grid-cols-5'\""
  },
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "swisseph"
    ],
    "overrides": {
      "baseline-browser-mapping": "latest",
      "fast-xml-parser": "^5.7.0",
      "glob": "^11.1.0",
      "tar": "^7.5.11",
      "minimatch": "^10.2.3",
      "node-forge": "^1.4.0",
      "jws": "^4.0.1",
      "flatted": "^3.4.2",
      "picomatch": "^4.0.4",
      "@xmldom/xmldom": "^0.8.13",
      "protobufjs": "^7.5.5",
      "i18next-fs-backend": "^2.6.4",
      "js-yaml": "^4.1.1",
      "ajv": "^6.14.0",
      "yaml": "^2.8.3",
      "axios": "^1.15.2",
      "next>postcss": "^8.5.10",
      "preact": "^10.27.3",
      "lodash": "^4.17.24",
      "uuid": "^14.0.0",
      "@tootallnate/once": "^3.0.1",
      "@isaacs/brace-expansion": "^5.0.1"
    }
  },
  "dependencies": {
    "@astrodraw/astrochart": "^3.0.2",
